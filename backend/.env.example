# DB_URL / DB_USERNAME / DB_PASSWORD: Postgres connection details.
DB_URL=jdbc:postgresql://localhost:5432/univendor
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT_SECRET: required, no default. Must be a long random value (HS256 needs 32+ bytes).
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# JWT_EXPIRATION_MINUTES: optional, defaults to 60 if unset.
JWT_EXPIRATION_MINUTES=60
